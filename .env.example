# ====================================================================
# StudentInsight Environment Configuration Template
# Copy this file to `.env` and replace ALL CHANGE_ME values before
# deploying to any staging or production environment!
# ====================================================================

# PostgreSQL Database (Local or Supabase Session Pooler)
# For Supabase Session Pooler, use:
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
POSTGRES_DB=studentinsight_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/studentinsight_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
SPRING_DATASOURCE_HIKARI_MAX_POOL_SIZE=6

# JWT Security (generate with: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_GENERATE_64_HEX_CHARACTER_SECRET_KEY
JWT_EXPIRATION_MS=86400000

# Initial Bootstrap User (set strong password in production; disable after initial login if desired)
APP_BOOTSTRAP_DEFAULT_USER_ENABLED=true
APP_BOOTSTRAP_DEFAULT_USER_USERNAME=user
APP_BOOTSTRAP_DEFAULT_USER_EMAIL=user@unklab.ac.id
APP_BOOTSTRAP_DEFAULT_USER_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# CORS Allowed Origins (comma-separated, MUST match your real production domain(s))
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ML_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000

# ML Service Integration & Shared Secret
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_API_KEY=CHANGE_ME_STRONG_ML_SERVICE_API_KEY
API_SECRET_KEY=CHANGE_ME_STRONG_ML_SERVICE_API_KEY
HISTORICAL_DATA_HOST_DIR=../Data Poin Mahasiswa
HISTORICAL_DATA_DIR=D:/from c/Documents/holyyy/ML/Data Poin Mahasiswa
ML_RANDOM_STATE=42

# AI Assistant "Jago" (supports DeepSeek & Gemini; provider=auto prefers DeepSeek if set, else Gemini, else Smart Local Fallback)
ASSISTANT_PROVIDER=auto
DEEPSEEK_API_KEY=CHANGE_ME_YOUR_DEEPSEEK_API_KEY
DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=CHANGE_ME_YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.1-flash-lite

# Logging
APP_LOG_LEVEL=INFO

# Frontend Configuration
# Leave as `/api/v1` when using Nginx reverse proxy (Docker) or Vite dev proxy.
# Set to full backend URL (e.g. https://api.yourdomain.com/api/v1) if hosting frontend separately.
VITE_API_BASE_URL=/api/v1
VITE_APP_TITLE=StudentInsight
FRONTEND_PORT=3000
